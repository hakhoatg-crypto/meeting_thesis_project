# Copy file nay thanh ".env" (cung thu muc) roi dien gia tri THAT (moi) vao.
# File ".env" da duoc liet ke trong .gitignore - se KHONG bao gio bi day len Git.
# LUU Y: ban vua phai REVOKE toan bo key cu bi lo trong ban zip truoc - dan key MOI vao day.

# --- Speech-to-Text cho cuoc hop chinh (AssemblyAI - cloud) ---
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_LANGUAGE_CODE=vi

# --- LLM Summary (tuy chon) ---
OPENAI_API_KEY=
LLM_SUMMARY_MODEL=gpt-4o-mini
ENABLE_LLM_SUMMARY=true

# --- Bao mat API: tao bang lenh `openssl rand -hex 32` ---
API_AUTH_TOKEN=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Cloudinary: luu tru audio rieng theo tung tai khoan ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
